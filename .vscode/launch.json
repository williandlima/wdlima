{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "debugpy",
            "request": "launch",
            "name": "Python: main.py",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            // Fixa o interpretador do venv pyside6-py311 (onde o PySide6 está
            // instalado). Sem isto, o depurador (F5) caía no Python global
            // "recomendado" pelo seletor, que NAO tem o PySide6 ->
            // "ModuleNotFoundError: No module named 'PySide6'".
            //
            // Este repositório é compartilhado entre Windows e macOS -- um
            // caminho fixo único quebrava a outra máquina (ex.: caminho do
            // Windows tentando rodar no Mac, "\\envs\\...\\python.exe" como
            // comando, code 127). As chaves "windows"/"osx" abaixo sobrescrevem
            // "python" só para a plataforma correspondente; ajuste o nome do
            // venv em cada uma se você criar o ambiente com outro nome.
            "windows": {
                "python": "${env:USERPROFILE}\\envs\\pyside6-py311\\Scripts\\python.exe"
            },
            "osx": {
                "python": "${env:HOME}/venvs/pyside6-py311/bin/python3"
            }
        }
    ]
}